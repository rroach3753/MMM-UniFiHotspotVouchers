# UniFi controller connection and authentication
UNIFI_HOTSPOT_URL=https://unifi.local
UNIFI_HOTSPOT_API_KEY=replace-with-server-only-api-key

# Server-owned access and disclosure policy
UNIFI_HOTSPOT_SITE=default
UNIFI_HOTSPOT_VOUCHER_CODE_POLICY=hidden

# Optional strict multi-instance site mapping. When set, unlisted instances fail closed.
# UNIFI_HOTSPOT_INSTANCE_SITES={"module_1":"default","module_2":"guest"}

# Optional connection settings
# UNIFI_HOTSPOT_API_KEY_HEADER=X-API-Key
# UNIFI_HOTSPOT_VERIFY_SSL=true
